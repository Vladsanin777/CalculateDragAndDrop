{
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.compilerPath": "/usr/bin/g++",  // Путь к g++
    "cmake.generator": "Ninja",  // Или "Unix Makefiles"
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "code-runner.executorMap": {
        "cpp": "cd ${workspaceFolder} && g++ -std=c++17 src/main.cpp -o build/my_app && ./build/my_app"
    }
}